{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/engineering-skills/registry/main/schemas/manifest.schema.json",
  "title": "SkillManifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "type",
    "status",
    "category",
    "description",
    "provider",
    "source",
    "entrypoints"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "type": {
      "type": "string",
      "enum": ["technology", "practice", "intelligence"]
    },
    "status": {
      "type": "string",
      "enum": ["official", "curated", "internal", "deprecated"]
    },
    "category": { "type": "string" },
    "description": { "type": "string", "minLength": 10, "maxLength": 500 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provider": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "repository", "ref", "license", "verified_at"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["official", "curated_community", "internal"]
        },
        "repository": { "type": "string" },
        "ref_type": {
          "type": "string",
          "enum": ["tag", "commit", "release", "local"]
        },
        "ref": { "type": "string" },
        "commit": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|local)$"
        },
        "path": { "type": "string" },
        "license": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "integrity": {
          "type": "object",
          "required": ["algorithm", "hash"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "type": "string", "enum": ["sha256"] },
            "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provides": {
          "type": "array",
          "items": { "type": "string" }
        },
        "produces_artifacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "kind": { "type": "string", "enum": ["hard", "recommended", "optional"] }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_agent_api": { "type": "string" },
        "operating_systems": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["skill_doc"],
      "additionalProperties": false,
      "properties": {
        "skill_doc": { "type": "string" },
        "schema_dir": { "type": "string" },
        "template_dir": { "type": "string" }
      }
    },
    "update_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual", "pin_only", "auto_minor"]
        }
      }
    }
  }
}
